#include <iostream>
#include <vector>
#include <limits>
using namespace std;

int main() {
    // Example input: list of ages
    vector<int> ages = {23, 45, 19, 67, 34};
    
    // Initialize minAge to maximum possible value and maxAge to minimum possible value
    int minAge = numeric_limits<int>::max();
    int maxAge = numeric_limits<int>::min();
    
    // Single pass to find minimum and maximum ages
    for (int age : ages) {
        if (age < minAge) {
            minAge = age;
        }
        if (age > maxAge) {
            maxAge = age;
        }
    }
    
    // Calculate the age gap (difference)
    int ageGap = maxAge - minAge;
    
    cout << "Age gap is: " << ageGap << endl;
    return 0;
}
Time Complexity: O(n) – a single pass through the array.
Space Complexity: O(1) – only constant space is used.
