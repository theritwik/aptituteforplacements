cpp
#include <iostream>
#include <string>

using namespace std;

int main() {
    // Example input: a series of directional characters
    string directions;
    cout << "Enter the directions string (e.g., NNEESW): ";
    cin >> directions;

    // Initialize counters for horizontal and vertical displacements
    int vertical = 0;   // +1 for N, -1 for S
    int horizontal = 0; // +1 for E, -1 for W

    // Brute Force: Iterating through each character in the string
    for (char d : directions) {
        if (d == 'N') {
            vertical++;
        } else if (d == 'S') {
            vertical--;
        } else if (d == 'E') {
            horizontal++;
        } else if (d == 'W') {
            horizontal--;
        }
        // Additional: Ignore invalid characters (if any)
    }

    // Determine the final sense of direction based on the net displacement
    string finalDirection;
    
    if (vertical > 0) {
        finalDirection += "North";
    } else if (vertical < 0) {
        finalDirection += "South";
    }
    
    if (horizontal > 0) {
        finalDirection += (finalDirection.empty() ? "East" : "-East");
    } else if (horizontal < 0) {
        finalDirection += (finalDirection.empty() ? "West" : "-West");
    }
    
    // If both displacements are zero, the traveler returns to the origin.
    if (vertical == 0 && horizontal == 0) {
        finalDirection = "Origin";
    }

    cout << "Final Sense of Direction: " << finalDirection << "n"; return 0; ``` **Time Complexity:** O(n) because every character in the input string is processed once. **Space Complexity:** O(1) since only a constant amount of extra space is used (two counters and a few string variables). ## Section 4 — Approach 2: Optimal Solution ### Step-by-Step Approach 1. **Count Frequency:** Instead of checking direction by direction, count the number of times each cardinal direction occurs in one scan.
2. **Net Calculation:** Compute the net vertical displacement as (count of 'N' – count of 'S') and the net horizontal displacement as (count of 'E' – count of 'W').
3. **Determine the Output:** - If vertical > 0, include "North"; if vertical < 0, include "South". - If horizontal > 0, include "East"; if horizontal < 0, include "West". - Combine these appropriately. - If both displacements are zero, output "Origin". ### Code ```cpp
#include <iostream>
#include <string> using namespace std; int main() // Input the directions string string directions; cout << "Enter the directions string (e.g., NNEESW): "; cin >> directions; // Count occurrences for each direction int countN = 0, countS = 0, countE = 0, countW = 0; for (char d : directions) if (d == 'N') countN++; else if (d == 'S') countS++; else if (d == 'E') countE++; else if (d == 'W') countW++; // Compute net displacements int vertical = countN - countS; int horizontal = countE - countW; // Build the final direction string based on net displacements string finalDirection; if (vertical > 0) finalDirection += "North"; else if (vertical < 0) finalDirection += "South"; if (horizontal > 0) finalDirection += (finalDirection.empty() ? "East" : "-East"); else if (horizontal < 0) finalDirection += (finalDirection.empty() ? "West" : "-West"); if (vertical == 0 && horizontal == 0) finalDirection = "Origin"; cout << "Final Sense of Direction: " << finalDirection << "n";
    return 0;
}
Time Complexity: O(n) because the string is scanned once entirely.
Space Complexity: O(1) since we use only five integer variables regardless of the input size.

