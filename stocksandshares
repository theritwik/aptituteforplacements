// Define a class for a Stock
class Stock {
    // Constructor initializes stock with a name, current price, and quantity owned
    constructor(name, currentPrice, quantity = 0) {
        this.name = name;
        this.currentPrice = currentPrice;
        this.quantity = quantity;
    }
    
    // Method to update the stock price
    updatePrice(newPrice) {
        this.currentPrice = newPrice;
    }
    
    // Method to calculate the total value of the stock holding
    getValue() {
        return this.currentPrice * this.quantity;
    }
}

// Define a class for a Portfolio containing multiple stocks
class Portfolio {
    constructor() {
        this.stocks = {};
    }
    
    // Method to add or update stock in portfolio
    addStock(stock, quantity) {
        if (this.stocks[stock.name]) {
            this.stocks[stock.name].quantity += quantity;
        } else {
            stock.quantity = quantity;
            this.stocks[stock.name] = stock;
        }
    }
    
    // Method to remove stock (sell)
    removeStock(stockName, quantity) {
        if (this.stocks[stockName] && this.stocks[stockName].quantity >= quantity) {
            this.stocks[stockName].quantity -= quantity;
            // If all shares are sold, remove the stock from portfolio
            if (this.stocks[stockName].quantity === 0) {
                delete this.stocks[stockName];
            }
        } else {
            print("Insufficient shares or stock does not exist.");
        }
    }
    
    // Calculate the total portfolio value
    getTotalValue() {
        let totalValue = 0;
        for (let stock of Object.values(this.stocks)) {
            totalValue += stock.getValue();
        }
        return totalValue;
    }
    
    // Display portfolio details
    displayPortfolio() {
        for (let stockName in this.stocks) {
            let stock = this.stocks[stockName];
            print("Stock: " + stock.name + ", Price: " + stock.currentPrice + ", Quantity: " + stock.quantity + ", Total Value: " + stock.getValue());
        }
        print("Portfolio Total Value: " + this.getTotalValue());
    }
}

